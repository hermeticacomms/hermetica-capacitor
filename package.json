{
  "name": "@hermeticor/sdk-capacitor",
  "version": "0.4.5",
  "description": "Hermetica for Capacitor and Ionic: events, consent, native push tokens, in-app messages",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hermeticacomms/hermetica-capacitor.git"
  },
  "homepage": "https://github.com/hermeticacomms/hermetica-capacitor#readme",
  "keywords": [
    "hermeticor",
    "hermetica",
    "email",
    "sms",
    "outreach"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hermeticor/sdk-browser": "^0.4.5"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@capacitor/push-notifications": ">=5"
  },
  "peerDependenciesMeta": {
    "@capacitor/push-notifications": {
      "optional": true
    }
  }
}
